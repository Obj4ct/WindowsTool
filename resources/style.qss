/* ============================================================
   WindowsTool 主题
   三区结构：深色导航侧栏 + 浅色卡片内容区 + 深色控制台
   ============================================================ */

* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI";
}

/* ---------------- 根容器 ---------------- */
#centralwidget {
    background: #F4F6FA;
}

/* ---------------- 顶栏 ---------------- */
#headerFrame {
    background: #FFFFFF;
    border-bottom: 1px solid #E6EAF1;
}

#appTitle {
    color: #16202E;
    font-size: 17px;
    font-weight: 600;
}

#appSubtitle {
    color: #93A0B4;
    font-size: 12px;
}

#aboutButton {
    background: #F3F6FB;
    border: 1px solid #E2E8F2;
    border-radius: 8px;
    color: #4A576F;
    font-size: 13px;
    padding: 7px 18px;
}
#aboutButton:hover {
    background: #E9F0FC;
    border-color: #CBD9F2;
    color: #2B6CD4;
}
#aboutButton:pressed {
    background: #DEE8FA;
}

/* ---------------- 侧边导航 ---------------- */
#sidebarFrame {
    background: #151D2E;
    border-right: 1px solid #0D1422;
}

#sideSection {
    color: #5C6A84;
    font-size: 11px;
    font-weight: 600;
    padding: 6px 12px;
}

#sideVersion {
    color: #47536B;
    font-size: 11px;
    padding: 0 12px;
}

#navOverviewBtn, #navNetworkBtn, #navSystemBtn,
#navHardwareBtn, #navManageBtn, #navToolsBtn {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    color: #93A0B8;
    font-size: 14px;
    padding: 11px 14px;
    text-align: left;
}
#navOverviewBtn:hover, #navNetworkBtn:hover, #navSystemBtn:hover,
#navHardwareBtn:hover, #navManageBtn:hover, #navToolsBtn:hover {
    background: #1D2739;
    color: #DCE4F0;
}
#navOverviewBtn:checked, #navNetworkBtn:checked, #navSystemBtn:checked,
#navHardwareBtn:checked, #navManageBtn:checked, #navToolsBtn:checked {
    background: #1F2B40;
    border-left: 3px solid #4A8CFF;
    color: #FFFFFF;
}

/* ---------------- 内容卡片 ---------------- */
#pageOverview, #pageOverviewInner, #pageNetwork, #pageNetworkInner,
#pageSystem, #pageSystemInner, #pageHardware, #pageHardwareInner,
#pageManage, #pageManageInner, #pageTools, #pageToolsInner {
    background: transparent;
    border: none;
}

#cardNetwork, #cardAdvanced, #cardOverview, #cardOverviewScore, #cardOverviewRecent,
#cardSystem, #cardHealth, #cardHardware, #cardManage, #cardTools,
#cardStartup, #cardPorts, #cardLargeFiles, #cardDiskHealth, #cardHwinfo,
#cardProcesses, #cardDiskUsage, #cardUninstall, #cardDrivers, #cardHosts,
#cardDns, #cardMonitor, #cardShortcuts, #cardBattery {
    background: #FFFFFF;
    border: 1px solid #E6EAF2;
    border-radius: 14px;
}

#cardTitleOverview, #cardTitleScore, #cardTitleRecent, #cardTitleNet, #cardTitleAdv,
#cardTitleSys, #cardTitleHardware, #cardTitleManage, #cardTitleTools,
#healthTitle, #startupTitle, #portsTitle, #largeFilesTitle, #diskHealthTitle,
#hwinfoTitle, #processesTitle, #diskUsageTitle, #uninstallTitle, #driversTitle,
#hostsTitle, #dnsTitle, #monitorTitle, #batteryTitle, #cardTitleTool {
    color: #1B2637;
    font-size: 15px;
    font-weight: 600;
}

#cardHintOverview, #cardHintScore, #cardHintRecent, #cardHintNet, #cardHintAdv,
#cardHintSys, #cardHintHardware, #cardHintManage, #cardHintTools, #cardHintTool {
    color: #96A2B6;
    font-size: 12px;
}

/* ---------------- 功能磁贴 ---------------- */
/* 只列出可用功能；规划中的磁贴不进 ID 选择器，交给下面的 [placeholder] 灰色样式 */
#btn_quickHealth, #btn_quickNetwork, #btn_quickPorts, #btn_quickDisk,
#btn_autoCheck, #btn_showNetWork, #btn_netWorkTest, #btn_ports,
#btn_hosts, #btn_dns,
#btn_cleaner, #btn_fixWhite, #btn_healthCheck,
#btn_diskHealth, #btn_hwinfo, #btn_monitor, #btn_startup, #btn_process, #btn_uninstall,
#btn_drivers, #btn_largeFiles, #btn_treedisk, #btn_prt {
    background: #FFFFFF;
    border: 1px solid #E3E8F1;
    border-radius: 12px;
    color: #1E2A3B;
    font-size: 14px;
    font-weight: 600;
    padding: 16px 8px;
}
#btn_quickHealth:hover, #btn_quickNetwork:hover, #btn_quickPorts:hover, #btn_quickDisk:hover,
#btn_autoCheck:hover, #btn_showNetWork:hover, #btn_netWorkTest:hover, #btn_ports:hover,
#btn_hosts:hover, #btn_dns:hover,
#btn_cleaner:hover, #btn_fixWhite:hover, #btn_healthCheck:hover,
#btn_diskHealth:hover, #btn_hwinfo:hover, #btn_monitor:hover, #btn_startup:hover, #btn_process:hover,
#btn_uninstall:hover, #btn_drivers:hover,
#btn_largeFiles:hover, #btn_treedisk:hover, #btn_prt:hover {
    background: #FAFCFF;
    border-color: #AEC7F4;
    color: #1A5FD0;
}
#btn_quickHealth:pressed, #btn_quickNetwork:pressed, #btn_quickPorts:pressed, #btn_quickDisk:pressed,
#btn_autoCheck:pressed, #btn_showNetWork:pressed, #btn_netWorkTest:pressed, #btn_ports:pressed,
#btn_hosts:pressed, #btn_dns:pressed,
#btn_cleaner:pressed, #btn_fixWhite:pressed, #btn_healthCheck:pressed,
#btn_diskHealth:pressed, #btn_hwinfo:pressed, #btn_monitor:pressed, #btn_startup:pressed, #btn_process:pressed,
#btn_uninstall:pressed, #btn_drivers:pressed,
#btn_largeFiles:pressed, #btn_treedisk:pressed, #btn_prt:pressed {
    background: #EFF4FD;
    border-color: #8FB4EE;
}
#btn_autoCheck:disabled, #btn_showNetWork:disabled, #btn_netWorkTest:disabled, #btn_ports:disabled, #btn_hosts:disabled, #btn_dns:disabled,
#btn_cleaner:disabled, #btn_fixWhite:disabled, #btn_healthCheck:disabled, #btn_startup:disabled, #btn_hwinfo:disabled, #btn_monitor:disabled, #btn_process:disabled, #btn_uninstall:disabled, #btn_drivers:disabled, #btn_largeFiles:disabled, #btn_treedisk:disabled, #btn_diskHealth:disabled, #btn_prt:disabled {
    background: #F7F8FA;
    border-color: #EAEEF4;
    color: #B6BFCC;
}

/* 规划中功能：磁贴置灰，点击只提示"功能开发中"，不改变任何设置 */
QToolButton[placeholder="true"] {
    background: #F6F7F9;
    border: 1px solid #EBEEF3;
    border-radius: 12px;
    color: #A9B3C2;
    font-size: 14px;
    font-weight: 600;
    padding: 16px 8px;
}
QToolButton[placeholder="true"]:hover {
    background: #F2F4F8;
    border-color: #DDE3EC;
    color: #8C97A8;
}
QToolButton[placeholder="true"]:pressed {
    background: #ECEEF4;
    border-color: #D3DAE5;
}

/* 次级按钮 */
#btn_refreshDNS, #btn_resetWinSock, #btn_key {
    background: #FFFFFF;
    border: 1px solid #E1E7F0;
    border-radius: 9px;
    color: #4A576F;
    font-size: 13px;
    padding: 9px 16px;
}
#btn_refreshDNS:hover, #btn_resetWinSock:hover, #btn_key:hover {
    background: #F5F8FE;
    border-color: #B9CDF0;
    color: #2B6CD4;
}
#btn_refreshDNS:pressed, #btn_resetWinSock:pressed, #btn_key:pressed {
    background: #EAF1FC;
}

/* ---------------- 电脑体检结果 ---------------- */
#healthSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}
#healthSummary[state="ok"] {
    color: #1F8A4C;
}
#healthSummary[state="warn"] {
    color: #B7791F;
}
#healthSummary[state="risk"] {
    color: #C0392B;
}

#healthBadge {
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 6px;
}
#healthBadge[state="ok"] {
    background: #E8F7EE;
    color: #1F8A4C;
}
#healthBadge[state="warn"] {
    background: #FFF6E5;
    color: #B7791F;
}
#healthBadge[state="risk"] {
    background: #FDECEC;
    color: #C0392B;
}

#healthName {
    color: #1E2A3B;
    font-size: 13px;
    font-weight: 600;
}
#healthDetail {
    color: #7A879B;
    font-size: 12px;
}

/* ---------------- 开机启动项 ---------------- */
#startupSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#startupScroll, #startupRows {
    background: transparent;
    border: none;
}

#startupSource {
    background: #EEF3FB;
    border-radius: 8px;
    color: #3A66B0;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 6px;
}

#startupName {
    color: #1E2A3B;
    font-size: 13px;
    font-weight: 600;
}

#startupCommand {
    color: #7A879B;
    font-size: 12px;
}

/* ---------------- 端口占用 ---------------- */
#portsSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#portsScroll, #portsRows {
    background: transparent;
    border: none;
}

#portBadge {
    background: #EEF3FB;
    border-radius: 8px;
    color: #3A66B0;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 6px;
}

#portName {
    color: #1E2A3B;
    font-size: 13px;
    font-weight: 600;
}

#portDetail {
    color: #7A879B;
    font-size: 12px;
}

/* ---------------- 大文件扫描 ---------------- */
#largeFilesSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#largeFilesScroll, #largeFilesRows {
    background: transparent;
    border: none;
}

#largeFileSize {
    background: #EEF3FB;
    border-radius: 8px;
    color: #3A66B0;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 6px;
}

#largeFileName {
    color: #1E2A3B;
    font-size: 13px;
    font-weight: 600;
}

#largeFilePath {
    color: #7A879B;
    font-size: 12px;
}

/* ---------------- 磁盘健康 ---------------- */
#diskHealthSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#diskHealthScroll, #diskHealthRows {
    background: transparent;
    border: none;
}

#diskBadge {
    background: #E8F6EE;
    border-radius: 8px;
    color: #2E8B57;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 6px;
}

#diskBadge[state="warn"] {
    background: #FFF4E5;
    color: #C77700;
}

#diskBadge[state="bad"] {
    background: #FDECEC;
    color: #C0392B;
}

#diskName {
    color: #1E2A3B;
    font-size: 13px;
    font-weight: 600;
}

#diskDetail {
    color: #7A879B;
    font-size: 12px;
}

/* ---------------- 硬件信息 ---------------- */
#hwinfoSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#hwinfoScroll, #hwinfoRows {
    background: transparent;
    border: none;
}

#hwBadge {
    background: #E8F0FE;
    border-radius: 8px;
    color: #2B6CD4;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 6px;
}

#hwName {
    color: #1E2A3B;
    font-size: 13px;
    font-weight: 600;
}

#hwDetail {
    color: #7A879B;
    font-size: 12px;
}

/* ---------------- 进程列表 ---------------- */
#processesSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#processesScroll, #processesRows {
    background: transparent;
    border: none;
}

#procBadge {
    background: #EEF1F6;
    border-radius: 8px;
    color: #5B6980;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 6px;
}

#procName {
    color: #1E2A3B;
    font-size: 13px;
    font-weight: 600;
}

#procDetail {
    color: #7A879B;
    font-size: 12px;
}

/* ---------------- 目录占用 ---------------- */
#diskUsageSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#diskUsageScroll, #diskUsageRows {
    background: transparent;
    border: none;
}

#usageBadge {
    background: #EEF6F1;
    border-radius: 8px;
    color: #2E7D5B;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 6px;
}

#usageName {
    color: #1E2A3B;
    font-size: 13px;
    font-weight: 600;
}

#usageDetail {
    color: #7A879B;
    font-size: 12px;
}

/* ---------------- 已安装程序 ---------------- */
#uninstallSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#uninstallScroll, #uninstallRows {
    background: transparent;
    border: none;
}

#appBadge {
    background: #F3EEF9;
    border-radius: 8px;
    color: #7A56C2;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 6px;
}

#appName {
    color: #1E2A3B;
    font-size: 13px;
    font-weight: 600;
}

#appDetail {
    color: #7A879B;
    font-size: 12px;
}

#appUninstallBtn {
    background: #F2F6FE;
    border: 1px solid #D7E4FA;
    border-radius: 6px;
    color: #2B6CD4;
    font-size: 12px;
    padding: 0 12px;
}

#appUninstallBtn:hover {
    background: #E8F0FE;
}

#appUninstallBtn:pressed {
    background: #D9E7FD;
}

/* ---------------- 驱动清单 ---------------- */
#driversSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#driversScroll, #driversRows {
    background: transparent;
    border: none;
}

#driverName {
    color: #1E2A3B;
    font-size: 13px;
    font-weight: 600;
}

#driverDetail {
    color: #7A879B;
    font-size: 12px;
}

/* ---------------- Hosts 编辑 ---------------- */
#hostsSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#hostsEditor {
    background: #FBFCFE;
    border: 1px solid #E3E8F1;
    border-radius: 10px;
    color: #2A3648;
    font-family: "Consolas", "Cascadia Mono", "Microsoft YaHei";
    font-size: 12px;
    padding: 8px;
}

#hostsEditor:focus {
    border-color: #AEC7F4;
}

#hostsSaveBtn {
    background: #4A8CFF;
    border: none;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

#hostsSaveBtn:hover {
    background: #3D7BE8;
}

#hostsSaveBtn:disabled {
    background: #C3D4F4;
    color: #F4F7FD;
}

#hostsRestoreBtn {
    background: #F2F4F8;
    border: 1px solid #E1E6EF;
    border-radius: 8px;
    color: #4A576F;
    font-size: 13px;
    padding: 0 16px;
}

#hostsRestoreBtn:hover {
    background: #EDF1F7;
}

#hostsRestoreBtn:disabled {
    color: #B6BFCC;
}

/* ---------------- DNS 切换 ---------------- */
#dnsSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#dnsAutoBtn, #dnsAliBtn, #dnsTencentBtn, #dns114Btn, #dnsGoogleBtn, #dnsBaiduBtn {
    background: #F2F4F8;
    border: 1px solid #E1E6EF;
    border-radius: 8px;
    color: #2A3648;
    font-size: 13px;
    padding: 0 14px;
}

#dnsAutoBtn:hover, #dnsAliBtn:hover, #dnsTencentBtn:hover,
#dns114Btn:hover, #dnsGoogleBtn:hover, #dnsBaiduBtn:hover {
    background: #EAF1FE;
    border-color: #C3D7F8;
    color: #2B6CD4;
}

#dnsAutoBtn:pressed, #dnsAliBtn:pressed, #dnsTencentBtn:pressed,
#dns114Btn:pressed, #dnsGoogleBtn:pressed, #dnsBaiduBtn:pressed {
    background: #E1EAFB;
}

#dnsAutoBtn:disabled, #dnsAliBtn:disabled, #dnsTencentBtn:disabled,
#dns114Btn:disabled, #dnsGoogleBtn:disabled, #dnsBaiduBtn:disabled {
    color: #B6BFCC;
}

/* ---------------- 实时监控 ---------------- */
#monitorSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#monCpuName, #monMemName, #monDiskName, #monNetName {
    color: #5A677D;
    font-size: 13px;
}

#monCpuVal, #monMemVal, #monDiskVal, #monNetVal {
    color: #2A3648;
    font-size: 13px;
    font-weight: 600;
}

#monCpuBar, #monMemBar, #monDiskBar {
    background: #F0F3F8;
    border: none;
    border-radius: 6px;
}

#monCpuBar::chunk, #monMemBar::chunk, #monDiskBar::chunk {
    background: #4A8CFF;
    border-radius: 6px;
}

#monitorStopBtn {
    background: #F2F4F8;
    border: 1px solid #E1E6EF;
    border-radius: 8px;
    color: #4A576F;
    font-size: 13px;
    padding: 0 16px;
}

#monitorStopBtn:hover {
    background: #EDF1F7;
}

#monitorStopBtn:disabled {
    color: #B6BFCC;
}

/* ---------------- 电池健康 ---------------- */
#batterySummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}

#batteryNameLabel, #batteryDesignLabel, #batteryFullLabel,
#batteryHealthLabel, #batteryChargeLabel, #batteryStatusLabel,
#batteryCycleLabel {
    color: #5A677D;
    font-size: 13px;
}

#batteryNameVal, #batteryDesignVal, #batteryFullVal,
#batteryHealthVal, #batteryChargeVal, #batteryStatusVal,
#batteryCycleVal {
    color: #2A3648;
    font-size: 13px;
    font-weight: 600;
}

/* ---------------- 日志控制台 ---------------- */
#logPanel {
    background: #101725;
    border: 1px solid #1D2637;
    border-radius: 12px;
}

#logHeader {
    background: #18202F;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom: 1px solid #222C3D;
}

#logTitle {
    color: #8FA0B8;
    font-size: 11px;
    font-weight: 600;
}

#clearLogButton {
    background: transparent;
    border: 1px solid #2C374B;
    border-radius: 6px;
    color: #7C8CA4;
    font-size: 11px;
    padding: 3px 12px;
}
#clearLogButton:hover {
    background: #222C3D;
    border-color: #3A4860;
    color: #C6D2E4;
}

QTextBrowser#textBrowser {
    background: #101725;
    border: none;
    color: #C3D0E4;
    font-family: "Consolas", "Cascadia Mono", "Microsoft YaHei UI";
    font-size: 12px;
    padding: 10px 12px;
    selection-background-color: #2B4C86;
    selection-color: #FFFFFF;
}

/* 快捷键页的内容视图 */
QTextBrowser#shortcutView {
    background: #FBFCFE;
    border: 1px solid #EDF0F6;
    border-radius: 10px;
    color: #3A4658;
    font-size: 13px;
    padding: 6px 10px;
    selection-background-color: #CFE0FB;
    selection-color: #16202E;
}

/* ---------------- 滚动条 ---------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px 2px 2px 0;
}
QScrollBar::handle:vertical {
    background: #C6CEDC;
    border-radius: 5px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: #A8B3C4;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0 2px 2px 2px;
}
QScrollBar::handle:horizontal {
    background: #C6CEDC;
    border-radius: 5px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: #A8B3C4;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* 控制台内滚动条用深色 */
#textBrowser QScrollBar::handle:vertical {
    background: #33415A;
}
#textBrowser QScrollBar::handle:vertical:hover {
    background: #465872;
}

/* ---------------- 提示气泡 ---------------- */
QToolTip {
    background: #1E2738;
    border: 1px solid #33405A;
    border-radius: 6px;
    color: #DCE4F0;
    padding: 5px 9px;
}
