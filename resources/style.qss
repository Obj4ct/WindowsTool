/* ============================================================
   WindowsTool 主题（重构版）
   左侧深色导航 + 右侧浅色内容区
   主色：#2F6FDE   背景：#F2F5FA   卡片：#FFFFFF
   ============================================================ */

* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI";
}

/* ---------------- 根容器 ---------------- */
#centralwidget, #contentArea, #stackedWidget {
    background: #F2F5FA;
    border: none;
}

/* ---------------- 侧边导航 ---------------- */
#sidebarFrame {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #12203A, stop:1 #0B1526);
    border-right: 1px solid #0A1220;
}

#appTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 600;
}

#appSubtitle {
    color: #8296B5;
    font-size: 11px;
}

#sideSection {
    color: #5C7191;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 14px 4px 14px;
}

#sideVersion {
    color: #4E6484;
    font-size: 11px;
    padding: 2px 14px 0 14px;
}

#aboutButton {
    background: transparent;
    border: 1px solid #22314C;
    border-radius: 9px;
    color: #93A7C4;
    font-size: 12px;
}
#aboutButton:hover {
    background: #192840;
    border-color: #33496B;
    color: #E2EBF9;
}
#aboutButton:pressed {
    background: #14223A;
}

#navOverviewBtn, #navNetworkBtn, #navSystemBtn,
#navHardwareBtn, #navManageBtn, #navToolsBtn {
    background: transparent;
    border: none;
    border-radius: 10px;
    color: #9BABC2;
    font-size: 14px;
    padding: 10px 14px;
    text-align: left;
}
#navOverviewBtn:hover, #navNetworkBtn:hover, #navSystemBtn:hover,
#navHardwareBtn:hover, #navManageBtn:hover, #navToolsBtn:hover {
    background: #182740;
    color: #E6EEFB;
}
#navOverviewBtn:checked, #navNetworkBtn:checked, #navSystemBtn:checked,
#navHardwareBtn:checked, #navManageBtn:checked, #navToolsBtn:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #2E68D6, stop:1 #2A5FC7);
    color: #FFFFFF;
}
#navOverviewBtn:checked:hover, #navNetworkBtn:checked:hover, #navSystemBtn:checked:hover,
#navHardwareBtn:checked:hover, #navManageBtn:checked:hover, #navToolsBtn:checked:hover {
    background: #3A76E4;
}

/* ---------------- 页面标题 ---------------- */
#pageTitleOverview, #pageTitleNetwork, #pageTitleSystem,
#pageTitleHardware, #pageTitleManage, #pageTitleTools {
    color: #16202E;
    font-size: 21px;
    font-weight: 600;
}

#pageDescOverview, #pageDescNetwork, #pageDescSystem,
#pageDescHardware, #pageDescManage, #pageDescTools {
    color: #8795AB;
    font-size: 12px;
}

/* ---------------- 内容页 ---------------- */
#pageOverview, #pageOverviewInner, #pageNetwork, #pageNetworkInner,
#pageSystem, #pageSystemInner, #pageHardware, #pageHardwareInner,
#pageManage, #pageManageInner, #pageTools, #pageToolsInner {
    background: transparent;
    border: none;
}

#cardOverview, #cardOverviewScore, #cardNetwork, #cardAdvanced,
#cardPorts, #cardHosts, #cardDns, #cardSystem, #cardHealth,
#cardSfc, #cardWUpdate, #cardHardware, #cardHwinfo, #cardDiskHealth,
#cardMonitor, #cardBattery, #cardManage, #cardStartup, #cardProcesses,
#cardUninstall, #cardDrivers, #cardTools, #cardLargeFiles,
#cardDiskUsage, #cardDup, #cardContextMenu, #cardBootTime, #cardFileLock {
    background: #FFFFFF;
    border: 1px solid #E7ECF4;
    border-radius: 14px;
}

/* 健康评分卡片做成浅蓝提示条，和普通卡片区分 */
#cardOverviewScore {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #EEF5FF, stop:1 #E3EEFF);
    border: 1px solid #D7E5FC;
}

#cardTitleOverview, #cardTitleScore, #cardTitleNet, #cardTitleAdv,
#cardTitleSys, #cardTitleHardware, #cardTitleManage, #cardTitleTools,
#healthTitle, #portsTitle, #hostsTitle, #dnsTitle, #sfcTitle, #wupdateTitle,
#hwinfoTitle, #diskHealthTitle, #monitorTitle, #batteryTitle,
#startupTitle, #processesTitle, #uninstallTitle, #driversTitle,
#largeFilesTitle, #diskUsageTitle, #dupTitle,
#contextMenuTitle, #bootTimeTitle, #fileLockTitle {
    color: #1A2433;
    font-size: 15px;
    font-weight: 600;
}

#cardHintOverview, #cardHintScore, #cardHintNet, #cardHintAdv,
#cardHintSys, #cardHintHardware, #cardHintManage, #cardHintTools {
    color: #93A0B4;
    font-size: 12px;
}

/* ---------------- 功能磁贴 ---------------- */
#btn_quickHealth, #btn_quickNetwork, #btn_quickPorts, #btn_quickDisk,
#btn_autoCheck, #btn_showNetWork, #btn_ports, #btn_hosts, #btn_dns,
#btn_cleaner, #btn_fixWhite, #btn_healthCheck, #btn_sfc, #btn_wupdate,
#btn_diskHealth, #btn_hwinfo, #btn_battery, #btn_monitor,
#btn_startup, #btn_process, #btn_uninstall, #btn_drivers,
#btn_largeFiles, #btn_treedisk, #btn_dup, #btn_contextMenu,
#btn_bootTime, #btn_fileLock {
    background: #F7F9FD;
    border: 1px solid #E6ECF6;
    border-radius: 12px;
    color: #243042;
    font-size: 13px;
    font-weight: 600;
    padding: 18px 8px 14px 8px;
}
#btn_quickHealth:hover, #btn_quickNetwork:hover, #btn_quickPorts:hover, #btn_quickDisk:hover,
#btn_autoCheck:hover, #btn_showNetWork:hover, #btn_ports:hover, #btn_hosts:hover, #btn_dns:hover,
#btn_cleaner:hover, #btn_fixWhite:hover, #btn_healthCheck:hover, #btn_sfc:hover, #btn_wupdate:hover,
#btn_diskHealth:hover, #btn_hwinfo:hover, #btn_battery:hover, #btn_monitor:hover,
#btn_startup:hover, #btn_process:hover, #btn_uninstall:hover, #btn_drivers:hover,
#btn_largeFiles:hover, #btn_treedisk:hover, #btn_dup:hover, #btn_contextMenu:hover,
#btn_bootTime:hover, #btn_fileLock:hover {
    background: #FFFFFF;
    border-color: #A9C4F5;
    color: #1C5FC9;
}
#btn_quickHealth:pressed, #btn_quickNetwork:pressed, #btn_quickPorts:pressed, #btn_quickDisk:pressed,
#btn_autoCheck:pressed, #btn_showNetWork:pressed, #btn_ports:pressed, #btn_hosts:pressed, #btn_dns:pressed,
#btn_cleaner:pressed, #btn_fixWhite:pressed, #btn_healthCheck:pressed, #btn_sfc:pressed, #btn_wupdate:pressed,
#btn_diskHealth:pressed, #btn_hwinfo:pressed, #btn_battery:pressed, #btn_monitor:pressed,
#btn_startup:pressed, #btn_process:pressed, #btn_uninstall:pressed, #btn_drivers:pressed,
#btn_largeFiles:pressed, #btn_treedisk:pressed, #btn_dup:pressed, #btn_contextMenu:pressed,
#btn_bootTime:pressed, #btn_fileLock:pressed {
    background: #EDF3FD;
    border-color: #8FB4EE;
}
#btn_quickHealth:disabled, #btn_quickNetwork:disabled, #btn_quickPorts:disabled, #btn_quickDisk:disabled,
#btn_autoCheck:disabled, #btn_showNetWork:disabled, #btn_ports:disabled, #btn_hosts:disabled,
#btn_dns:disabled, #btn_cleaner:disabled, #btn_fixWhite:disabled, #btn_healthCheck:disabled,
#btn_sfc:disabled, #btn_wupdate:disabled, #btn_diskHealth:disabled, #btn_hwinfo:disabled,
#btn_battery:disabled, #btn_monitor:disabled, #btn_startup:disabled, #btn_process:disabled,
#btn_uninstall:disabled, #btn_drivers:disabled, #btn_largeFiles:disabled, #btn_treedisk:disabled,
#btn_dup:disabled, #btn_contextMenu:disabled, #btn_bootTime:disabled, #btn_fileLock:disabled {
    background: #F6F8FB;
    border-color: #EBEFF5;
    color: #B6BFCC;
}

/* ---------------- 次级按钮 ---------------- */
#btn_refreshDNS, #btn_resetWinSock {
    background: #FFFFFF;
    border: 1px solid #E1E7F0;
    border-radius: 9px;
    color: #4A576F;
    font-size: 13px;
    padding: 0 16px;
}
#btn_refreshDNS:hover, #btn_resetWinSock:hover {
    background: #F5F8FE;
    border-color: #B9CDF0;
    color: #2B6CD4;
}
#btn_refreshDNS:pressed, #btn_resetWinSock:pressed {
    background: #EAF1FC;
}

/* ---------------- 电脑体检结果 ---------------- */
#healthSummary {
    color: #4A576F;
    font-size: 13px;
    font-weight: 600;
}
#healthSummary[state="ok"] {
    color: #1F8A4C;
}
#healthSummary[state="warn"] {
    color: #B7791F;
}
#healthSummary[state="risk"] {
    color: #C0392B;
}

#healthBadge {
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 6px;
}
#healthBadge[state="ok"] {
    background: #E8F7EE;
    color: #1F8A4C;
}
#healthBadge[state="warn"] {
    background: #FFF6E5;
    color: #B7791F;
}
#healthBadge[state="risk"] {
    background: #FDECEC;
    color: #C0392B;
}

#healthName {
    color: #1E2A3B;
    font-size: 13px;
    font-weight: 600;
}
#healthDetail {
    color: #7A879B;
    font-size: 12px;
}

/* ---------------- 健康评分 ---------------- */
#overviewScoreValue {
    color: #93A0B4;
    font-size: 36px;
    font-weight: 700;
}
#overviewScoreValue[state="ok"] {
    color: #1F8A4C;
}
#overviewScoreValue[state="info"] {
    color: #2B6CD4;
}
#overviewScoreValue[state="warn"] {
    color: #B7791F;
}
#overviewScoreValue[state="bad"] {
    color: #C0392B;
}

#overviewScoreGrade {
    color: #7A879B;
    font-size: 13px;
    font-weight: 600;
}
#overviewScoreGrade[state="ok"] {
    color: #1F8A4C;
}
#overviewScoreGrade[state="info"] {
    color: #2B6CD4;
}
#overviewScoreGrade[state="warn"] {
    color: #B7791F;
}
#overviewScoreGrade[state="bad"] {
    color: #C0392B;
}

/* ---------------- 列表通用 ---------------- */
#startupScroll, #startupRows,
#portsScroll, #portsRows,
#largeFilesScroll, #largeFilesRows,
#diskHealthScroll, #diskHealthRows,
#hwinfoScroll, #hwinfoRows,
#processesScroll, #processesRows,
#diskUsageScroll, #diskUsageRows,
#uninstallScroll, #uninstallRows,
#driversScroll, #driversRows,
#dupScroll, #dupRows,
#contextMenuScroll, #contextMenuRows,
#bootTimeScroll, #bootTimeRows,
#fileLockScroll, #fileLockRows {
    background: transparent;
    border: none;
}

#startupSummary, #portsSummary, #largeFilesSummary, #diskHealthSummary,
#hwinfoSummary, #processesSummary, #diskUsageSummary, #uninstallSummary,
#driversSummary, #hostsSummary, #dnsSummary, #monitorSummary,
#batterySummary, #dupSummary, #contextMenuSummary, #bootTimeSummary,
#fileLockSummary, #sfcSummary, #wupdateSummary {
    color: #4A576F;
    font-size: 13px;
}
#sfcSummary[state="ok"], #wupdateSummary[state="ok"] {
    color: #1F8A4C;
}
#sfcSummary[state="risk"], #wupdateSummary[state="risk"] {
    color: #C0392B;
}

/* 行内小标签 */
#startupSource, #portBadge, #largeFileSize, #hwBadge,
#cmBadge, #bootBadge, #lockBadge, #dupBadge, #procBadge,
#usageBadge, #appBadge {
    border-radius: 8px;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 7px;
}

#startupSource, #portBadge, #largeFileSize, #hwBadge,
#cmBadge, #bootBadge, #lockBadge, #dupBadge {
    background: #EEF3FB;
    color: #3A66B0;
}
#procBadge {
    background: #EEF1F6;
    color: #5B6980;
}
#usageBadge {
    background: #EAF5EF;
    color: #2E7D5B;
}
#appBadge {
    background: #F3EEF9;
    color: #7A56C2;
}
#diskBadge {
    background: #E8F6EE;
    border-radius: 8px;
    color: #2E8B57;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 7px;
}
#diskBadge[state="warn"] {
    background: #FFF4E5;
    color: #C77700;
}
#diskBadge[state="bad"] {
    background: #FDECEC;
    color: #C0392B;
}
#lockBadge[state="bad"] {
    background: #FDECEC;
    color: #C0392B;
}

/* 行内主标题 / 副标题 */
#startupName, #portName, #largeFileName, #diskName, #hwName,
#healthName, #procName, #usageName, #appName, #driverName,
#dupName, #cmName, #bootName, #lockName {
    color: #1E2A3B;
    font-size: 13px;
    font-weight: 600;
}
#startupCommand, #portDetail, #largeFilePath, #diskDetail, #hwDetail,
#healthDetail, #procDetail, #usageDetail, #appDetail, #driverDetail,
#dupDetail, #cmDetail, #bootDetail, #lockDetail {
    color: #7A879B;
    font-size: 12px;
}

/* ---------------- Hosts 编辑 ---------------- */
#hostsEditor {
    background: #FBFCFE;
    border: 1px solid #E3E8F1;
    border-radius: 10px;
    color: #2A3648;
    font-family: "Consolas", "Cascadia Mono", "Microsoft YaHei";
    font-size: 12px;
    padding: 8px;
}
#hostsEditor:focus {
    border-color: #A9C4F5;
}

#hostsSaveBtn {
    background: #2F6FDE;
    border: none;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}
#hostsSaveBtn:hover {
    background: #2860C8;
}
#hostsSaveBtn:disabled {
    background: #C3D4F4;
    color: #F4F7FD;
}

#hostsRestoreBtn {
    background: #F4F6FA;
    border: 1px solid #E1E6EF;
    border-radius: 8px;
    color: #4A576F;
    font-size: 13px;
    padding: 0 16px;
}
#hostsRestoreBtn:hover {
    background: #EDF1F7;
}
#hostsRestoreBtn:disabled {
    color: #B6BFCC;
}

/* ---------------- DNS 切换 ---------------- */
#dnsAutoBtn, #dnsAliBtn, #dnsTencentBtn, #dns114Btn, #dnsGoogleBtn, #dnsBaiduBtn {
    background: #F4F6FA;
    border: 1px solid #E1E6EF;
    border-radius: 8px;
    color: #2A3648;
    font-size: 13px;
    padding: 0 14px;
}
#dnsAutoBtn:hover, #dnsAliBtn:hover, #dnsTencentBtn:hover,
#dns114Btn:hover, #dnsGoogleBtn:hover, #dnsBaiduBtn:hover {
    background: #EAF1FE;
    border-color: #C3D7F8;
    color: #2B6CD4;
}
#dnsAutoBtn:pressed, #dnsAliBtn:pressed, #dnsTencentBtn:pressed,
#dns114Btn:pressed, #dnsGoogleBtn:pressed, #dnsBaiduBtn:pressed {
    background: #E1EAFB;
}
#dnsAutoBtn:disabled, #dnsAliBtn:disabled, #dnsTencentBtn:disabled,
#dns114Btn:disabled, #dnsGoogleBtn:disabled, #dnsBaiduBtn:disabled {
    color: #B6BFCC;
}

/* ---------------- 实时监控 ---------------- */
#monCpuName, #monMemName, #monDiskName, #monNetName {
    color: #5A677D;
    font-size: 13px;
}
#monCpuVal, #monMemVal, #monDiskVal, #monNetVal {
    color: #2A3648;
    font-size: 13px;
    font-weight: 600;
}
#monCpuBar, #monMemBar, #monDiskBar {
    background: #EEF2F8;
    border: none;
    border-radius: 6px;
}
#monCpuBar::chunk, #monMemBar::chunk, #monDiskBar::chunk {
    background: #2F6FDE;
    border-radius: 6px;
}

#monitorStopBtn {
    background: #F4F6FA;
    border: 1px solid #E1E6EF;
    border-radius: 8px;
    color: #4A576F;
    font-size: 13px;
    padding: 0 16px;
}
#monitorStopBtn:hover {
    background: #EDF1F7;
}
#monitorStopBtn:disabled {
    color: #B6BFCC;
}

/* ---------------- 电池健康 ---------------- */
#batteryNameLabel, #batteryDesignLabel, #batteryFullLabel,
#batteryHealthLabel, #batteryChargeLabel, #batteryStatusLabel,
#batteryCycleLabel {
    color: #5A677D;
    font-size: 13px;
}
#batteryNameVal, #batteryDesignVal, #batteryFullVal,
#batteryHealthVal, #batteryChargeVal, #batteryStatusVal,
#batteryCycleVal {
    color: #2A3648;
    font-size: 13px;
    font-weight: 600;
}

/* ---------------- 软件 / 驱动 / 重复文件操作按钮 ---------------- */
#appUninstallBtn {
    background: #F2F6FE;
    border: 1px solid #D7E4FA;
    border-radius: 6px;
    color: #2B6CD4;
    font-size: 12px;
    padding: 0 12px;
}
#appUninstallBtn:hover {
    background: #E8F0FE;
}
#appUninstallBtn:pressed {
    background: #D9E7FD;
}

#dupDeleteBtn {
    background: #F4F6FA;
    border: 1px solid #E1E6EF;
    border-radius: 8px;
    color: #4A576F;
    font-size: 13px;
    padding: 0 16px;
}
#dupDeleteBtn:hover {
    background: #EDF1F7;
}
#dupDeleteBtn:disabled {
    color: #B6BFCC;
}

#cmToggleBtn {
    background: #F4F6FA;
    border: 1px solid #E1E6EF;
    border-radius: 8px;
    color: #4A576F;
    font-size: 12px;
    padding: 4px 0;
}
#cmToggleBtn:hover {
    background: #EDF1F7;
    border-color: #CBD9F2;
    color: #2B6CD4;
}
#cmToggleBtn:disabled {
    color: #B6BFCC;
}

/* ---------------- 文件占用查询 ---------------- */
#fileLockPath {
    background: #FFFFFF;
    border: 1px solid #E1E7F0;
    border-radius: 9px;
    color: #2A3648;
    font-size: 13px;
    padding: 7px 10px;
}
#fileLockPath:focus {
    border-color: #A9C4F5;
}
#fileLockBrowseBtn {
    background: #FFFFFF;
    border: 1px solid #E1E7F0;
    border-radius: 9px;
    color: #4A576F;
    font-size: 13px;
    padding: 0 14px;
}
#fileLockBrowseBtn:hover {
    background: #F5F8FE;
    border-color: #B9CDF0;
    color: #2B6CD4;
}
#fileLockCheckBtn {
    background: #2F6FDE;
    border: 1px solid #2F6FDE;
    border-radius: 9px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}
#fileLockCheckBtn:hover {
    background: #2860C8;
    border-color: #2860C8;
}
#fileLockCheckBtn:pressed {
    background: #2453AE;
    border-color: #2453AE;
}
#fileLockCheckBtn:disabled {
    background: #E7ECF4;
    border-color: #E7ECF4;
    color: #B6BFCC;
}

/* ---------------- 系统文件修复 / Windows 更新修复 ---------------- */
#btnSfcScan, #btnWUpdateFix {
    background: #2F6FDE;
    border: 1px solid #2F6FDE;
    border-radius: 9px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}
#btnSfcScan:hover, #btnWUpdateFix:hover {
    background: #2860C8;
    border-color: #2860C8;
}
#btnSfcScan:pressed, #btnWUpdateFix:pressed {
    background: #2453AE;
    border-color: #2453AE;
}

#btnDismRepair {
    background: #FFFFFF;
    border: 1px solid #E1E7F0;
    border-radius: 9px;
    color: #4A576F;
    font-size: 13px;
    padding: 0 16px;
}
#btnDismRepair:hover {
    background: #F5F8FE;
    border-color: #B9CDF0;
    color: #2B6CD4;
}
#btnDismRepair:pressed {
    background: #EAF1FC;
}

#btnSfcScan:disabled, #btnDismRepair:disabled, #btnWUpdateFix:disabled {
    background: #E7ECF4;
    border-color: #E7ECF4;
    color: #B6BFCC;
}

#sfcLog, #wupdateLog {
    background: #101725;
    border: none;
    border-radius: 10px;
    color: #C3D0E4;
    font-family: "Consolas", "Cascadia Mono", "Microsoft YaHei UI";
    font-size: 12px;
    padding: 8px 10px;
    selection-background-color: #2B4C86;
    selection-color: #FFFFFF;
}

/* ---------------- 日志控制台 ---------------- */
#logPanel {
    background: #101725;
    border: 1px solid #1D2637;
    border-radius: 12px;
}
#logHeader {
    background: #18202F;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom: 1px solid #222C3D;
}
#logTitle {
    color: #8FA0B8;
    font-size: 11px;
    font-weight: 600;
}
#clearLogButton {
    background: transparent;
    border: 1px solid #2C374B;
    border-radius: 6px;
    color: #7C8CA4;
    font-size: 11px;
    padding: 3px 12px;
}
#clearLogButton:hover {
    background: #222C3D;
    border-color: #3A4860;
    color: #C6D2E4;
}

QTextBrowser#textBrowser {
    background: #101725;
    border: none;
    color: #C3D0E4;
    font-family: "Consolas", "Cascadia Mono", "Microsoft YaHei UI";
    font-size: 12px;
    padding: 10px 12px;
    selection-background-color: #2B4C86;
    selection-color: #FFFFFF;
}

/* ---------------- 滚动条 ---------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px 2px 2px 0;
}
QScrollBar::handle:vertical {
    background: #C4CDDC;
    border-radius: 5px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover {
    background: #A6B2C4;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    width: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0 2px 2px 2px;
}
QScrollBar::handle:horizontal {
    background: #C4CDDC;
    border-radius: 5px;
    min-width: 32px;
}
QScrollBar::handle:horizontal:hover {
    background: #A6B2C4;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0;
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

#textBrowser QScrollBar::handle:vertical {
    background: #33415A;
}
#textBrowser QScrollBar::handle:vertical:hover {
    background: #465872;
}

/* ---------------- 提示气泡 ---------------- */
QToolTip {
    background: #1E2738;
    border: 1px solid #33405A;
    border-radius: 6px;
    color: #DCE4F0;
    padding: 5px 9px;
}
